# Which service to use: openrouter  or  anthropic
LLM_PROVIDER=openrouter

# Paste your key after the = sign (OpenRouter keys start with sk-or-)
LLM_API_KEY=

# Only used for openrouter. Leave as is.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Models. ":free" models cost nothing but are rate-limited and can be retired.
# Full free list: https://openrouter.ai/models?max_price=0
MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_FAST=nvidia/nemotron-3.5-lightning:free
# Used automatically if the chosen model fails (OpenRouter picks any working free model)
MODEL_FALLBACK=openrouter/free

# Model "thinking": off | low | medium | high. off is much faster (labelling 38 columns: ~9s vs ~3 min).
REASONING_FAST=off
REASONING_SMART=low

# AI-down mode: any AI call slower than this (seconds) is abandoned and the app uses rules.
AI_TIMEOUT_S=20
# After an AI failure, skip AI for this many seconds (then retry automatically).
AI_COOLDOWN_S=60

# --- To switch to Anthropic later, change to: ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# MODEL_SMART=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
# MODEL_FALLBACK=
