# Copy this file to .env and paste your key. Only .env is read; it is never committed.
# Which service to use: deepseek | openrouter | anthropic
LLM_PROVIDER=deepseek

# Paste your key after the = sign (DeepSeek: https://platform.deepseek.com/api_keys)
LLM_API_KEY=

LLM_BASE_URL=https://api.deepseek.com

# deepseek-chat = no thinking (fast). deepseek-reasoner = thinks first (better, but often 20-60s).
MODEL_SMART=deepseek-chat
MODEL_FAST=deepseek-chat
MODEL_FALLBACK=

# Model "thinking": off | low | medium | high. Used by OpenRouter only (DeepSeek: the model name decides).
REASONING_FAST=off
REASONING_SMART=low

# AI-down mode: any AI call slower than this (seconds) is abandoned and the app uses rules.
AI_TIMEOUT_S=30
# After an AI failure, skip AI for this many seconds (then retry automatically).
AI_COOLDOWN_S=60

# --- OpenRouter instead (keys start with sk-or-; ":free" models are rate-limited) ---
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# MODEL_SMART=poolside/laguna-s-2.1:free
# MODEL_FAST=nvidia/nemotron-3.5-lightning:free
# MODEL_FALLBACK=openrouter/free

# --- Anthropic instead ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# MODEL_SMART=claude-sonnet-5-5
# MODEL_FAST=claude-haiku-5-5
# MODEL_FALLBACK=
